APP_NAME="Banha Delivery Network"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# On shared hosting use MySQL; SQLite is for local work only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=banha_delivery
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Platform
# --------------------------------------------------------------------------
PLATFORM_NAME="Banha Delivery Network"
PLATFORM_CITY=Banha
PLATFORM_COUNTRY=EG
PLATFORM_TIMEZONE=Africa/Cairo
PLATFORM_CURRENCY=EGP

# Pricing defaults, in piastres. Real prices come from the pricing_rules
# table; these only apply before any rule is seeded.
PRICING_DEFAULT_BASE_MINOR=1500
PRICING_DEFAULT_PER_KM_MINOR=300
PRICING_MINIMUM_FARE_MINOR=1500
PRICING_FREE_DISTANCE_METERS=1500
PRICING_ROUNDING_INCREMENT_MINOR=50
PLATFORM_FEE_BPS=1200

# Dispatch. Overridable at runtime from the admin settings screen.
DISPATCH_OFFER_TIMEOUT=90
DISPATCH_COMPANIES_PER_ROUND=2
DISPATCH_MAX_ROUNDS=4
DISPATCH_RIDER_OFFER_TIMEOUT=60

MATCHING_STRATEGY=weighted
MATCHING_MAX_PICKUP_DISTANCE=12000

# Rider GPS reporting. Raising the interval saves phone battery across the
# whole fleet at once.
TRACKING_PING_INTERVAL=15
TRACKING_RETENTION_DAYS=30

ROUTING_DRIVER=haversine
ROUTING_ROAD_FACTOR=1.32
ROUTING_AVERAGE_SPEED_KMH=22

API_RATE_LIMIT=120
COMPANY_COMMISSION_BPS=1200
RIDER_SHARE_BPS=7000
SETTLEMENT_PERIOD=weekly
