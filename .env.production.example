# banha.shop — production
#
# Copy to .env on the server and fill in the marked values. Everything already
# filled in is a deliberate choice for this deployment, not a default.

APP_NAME="شبكة بنها للتوصيل"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://banha.shop

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

# The city the network runs in. Working hours are wall-clock times here, so
# this is what they are compared against — not the server's clock.
PLATFORM_TIMEZONE=Africa/Cairo

# Warnings and above. Debug level on a shared host fills the disk quietly.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL on shared hosting. SQLite works but a single file on shared storage is
# a poor place for concurrent writes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                  # from the hosting panel
DB_USERNAME=
DB_PASSWORD=

# No worker and no cron: jobs run inline and time-due work is swept by
# ordinary traffic. Changing this to `database` without also running a worker
# means nothing dispatches at all.
QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.banha.shop
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
FILESYSTEM_DISK=public

# Proof photos are uploaded from a phone on mobile data.
MEDIA_PROOF_MAX_EDGE=1400
MEDIA_MAX_UPLOAD_KB=4096

# Free during the pilot. See config/platform.php for why.
PLATFORM_FEE_BPS=0
COMPANY_COMMISSION_BPS=0

MAIL_MAILER=smtp
MAIL_HOST=                    # from the hosting panel
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@banha.shop
MAIL_FROM_NAME="${APP_NAME}"
